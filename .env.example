# Copy this file to .env (local dev) or set the equivalent variable in
# your Netlify site settings, then redeploy.
#
# When unset, the app runs entirely on mock data — every page still works,
# but always shows the real "empty" state (or a labelled sample preview if
# you turn on Preview mode in Settings).
#
# Once your FastAPI backend is deployed, set this to its base URL and the
# app will call it directly instead of using mock data. No other code
# changes are required.
#
# Example: VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=
